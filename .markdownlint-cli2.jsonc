{
  "config": {
    "MD013": false
  },
  "ignores": [
    // PR/issue templates intentionally start with `## Summary` (no H1)
    // because GitHub renders the template inline in the PR body. The EAS
    // template is generated by ai-pipeline and must not be hand-edited.
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/ISSUE_TEMPLATE/**/*.md",
    // AGENTS.md carries a generated fleet-core block (compact list style, no
    // blank lines under headings) that the fleet checker keeps byte-identical,
    // and CLAUDE.md is the one-line `@AGENTS.md` import, which has no heading.
    "AGENTS.md",
    "CLAUDE.md"
  ]
}
