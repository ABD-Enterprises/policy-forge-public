{
  "config": {
    "MD013": false
  },
  "ignores": [
    // PR/issue templates intentionally start with `## Summary` (no H1)
    // because GitHub renders the template inline in the PR body. The EAS
    // template is generated by ai-pipeline and must not be hand-edited.
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/ISSUE_TEMPLATE/**/*.md"
  ]
}
